# Generated by scripts/screenshots.sh
Output "/tmp/search-dark.gif"
Set Shell "bash"
Set FontSize 14
Set Padding 16
Set TypingSpeed 60ms
Set Theme "Catppuccin Mocha"
Set Width 1800
Set Height 900
Env XDG_CONFIG_HOME "/work/cfg-dark"

Hide
Type "clear && /work/lazytree /work/repo"
Enter
Sleep 2s
Show
Type "/"
Type "search"
Sleep 500ms
Enter
Sleep 500ms
Type "n"
Sleep 300ms
Type "n"
Sleep 300ms
Type "n"
Sleep 1500ms
Screenshot docs/img/search-dark.png
