# Generated by scripts/screenshots.sh
Output "docs/img/demo.gif"
Set Shell "bash"
Set FontSize 14
Set Padding 16
Set TypingSpeed 60ms
Set Theme "Catppuccin Mocha"
Set Width 1400
Set Height 760
Set Framerate 24
Set PlaybackSpeed 1
Env XDG_CONFIG_HOME "/work/cfg-dark"

Hide
Type "clear && /work/lazytree /work/repo"
Enter
Sleep 2s
Show

# browse the graph; the diff follows the cursor
Sleep 800ms
Down 5
Sleep 1s
Down 4
Sleep 1s

# follow parents
Type "p"
Sleep 700ms
Type "p"
Sleep 700ms

# search with highlights, jump between matches
Type "/"
Type "search"
Sleep 800ms
Enter
Sleep 400ms
Type "n"
Sleep 900ms
Type "n"
Sleep 900ms
Escape
Sleep 400ms

# search git history by code
Type "/"
Type "g:perf"
Enter
Sleep 1.5s
Type "n"
Sleep 900ms
Escape
Sleep 400ms

# key bindings
Type "?"
Sleep 2s
Escape
Sleep 500ms

# zen mode
Type "z"
Sleep 5s
Type "z"
Sleep 600ms
