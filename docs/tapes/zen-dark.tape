# Generated by scripts/screenshots.sh
Output "/tmp/zen-dark.gif"
Set Shell "bash"
Set FontSize 14
Set Padding 16
Set TypingSpeed 60ms
Set Theme "Catppuccin Mocha"
Set Width 1800
Set Height 900
Env XDG_CONFIG_HOME "/work/cfg-dark"

Hide
Type "clear && /work/lazytree /work/repo"
Enter
Sleep 2s
Show
Type "z"
Sleep 7s
Screenshot docs/img/zen-dark.png
