# Generated by scripts/screenshots.sh
Output "/tmp/popup-dark.gif"
Set Shell "bash"
Set FontSize 14
Set Padding 16
Set TypingSpeed 60ms
Set Theme "Catppuccin Mocha"
Set Width 1100
Set Height 800
Env XDG_CONFIG_HOME "/work/cfg-dark"

Hide
Type "clear && /work/lazytree /work/repo"
Enter
Sleep 2s
Show
Down 4
Enter
Sleep 1500ms
Screenshot docs/img/popup-dark.png
